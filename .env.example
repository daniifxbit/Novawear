# Copy to .env (or export in your process manager) before running in production.

# --- Base de données --------------------------------------------------------
# PostgreSQL. Obligatoire : le serveur refuse de démarrer sans.
# En local  : postgresql://<user>@localhost:5432/novawear
# Sur Vercel : la chaîne de connexion « pooled » de Neon / Vercel Postgres.
DATABASE_URL=

# Back-office passphrase. Defaults to the design's demo code "NOVA" — change it.
ADMIN_CODE=change-me

# Signs admin session cookies. OBLIGATOIRE en production : le serveur refuse de
# démarrer sans. En serverless, une clé aléatoire par instance déconnecterait
# l'admin à presque chaque requête. Une longue chaîne aléatoire.
SESSION_SECRET=

# API port (default 4000).
PORT=4000

# Set to "production" so session cookies are marked Secure.
NODE_ENV=production

# --- Emails transactionnels -------------------------------------------------
# Sans SMTP configuré, les messages ne partent pas. En local ils sont écrits
# dans server/data/outbox (.eml) ; sur Vercel, où il n'y a pas de disque, ils
# sont seulement journalisés dans la table `emails`.

# Soit une URL de connexion complète…
SMTP_URL=

# …soit les paramètres séparés (SMTP_SECURE vaut true par défaut sur le port 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# Expéditeur affiché. Utilise un domaine que tu contrôles, avec SPF et DKIM,
# sinon les emails partiront en spam.
MAIL_FROM=NOVAWEAR <commandes@novawear.fr>

# Adresse prévenue à chaque nouvelle commande. Vide = pas de notification.
ADMIN_EMAIL=

# Base des liens contenus dans les emails (suivi de commande).
PUBLIC_URL=https://novawear.fr
