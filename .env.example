# Copy to .env (or export in your process manager) before running in production.

# Back-office passphrase. Defaults to the design's demo code "NOVA" — change it.
ADMIN_CODE=change-me

# Signs admin session cookies. Without it a random key is generated at each boot,
# which logs the admin out on every restart. Use a long random string.
SESSION_SECRET=

# API port (default 4000).
PORT=4000

# Where the SQLite database and uploads live (default: server/data).
DATA_DIR=

# Set to "production" so session cookies are marked Secure.
NODE_ENV=production
